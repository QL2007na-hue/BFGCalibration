<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>BFG电量校准</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  Scanning and connecting to the vehicle. Note that iOS needs no location
	  permission for BLE, unlike Android which required ACCESS_FINE_LOCATION.
	-->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>需要蓝牙权限以搜索并连接车辆，读取和校准电量参数。</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>需要蓝牙权限以搜索并连接车辆，读取和校准电量参数。</string>
	<!--
	  Keeps an established session alive if the rider switches away mid-write.
	  Declaring the central role only; the app never advertises.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<!--
	  Exposes the app's Documents directory to the Files app and to Finder /
	  iTunes file sharing. Without these two keys a successful diagnostic or
	  register-snapshot export writes the file and leaves the rider no way to
	  reach it: the folder never appears under "On My iPhone". Both export
	  dialogs promised exactly that, so the keys are part of the feature.
	-->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
